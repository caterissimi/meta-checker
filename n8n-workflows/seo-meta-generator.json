{
  "name": "SEO Meta Tag Generator from Google Sheets",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger-node",
      "name": "When clicking 'Test workflow'",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "",
          "mode": "list",
          "cachedResultName": "Select your spreadsheet"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "list",
          "cachedResultName": "Sheet1"
        },
        "options": {
          "range": ""
        }
      },
      "id": "google-sheets-read-node",
      "name": "Read Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [460, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "your-credential-id",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $json.URL }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "fetch-page-node",
      "name": "Fetch Page Content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "url-assignment",
              "name": "url",
              "value": "={{ $('Read Google Sheets').item.json.URL }}",
              "type": "string"
            },
            {
              "id": "row-assignment",
              "name": "rowNumber",
              "value": "={{ $('Read Google Sheets').itemIndex + 2 }}",
              "type": "number"
            },
            {
              "id": "content-assignment",
              "name": "pageContent",
              "value": "={{ \n// Extract text content from HTML\nconst html = $json.data || '';\n\n// Remove script and style tags\nlet cleanText = html.replace(/<script[^>]*>.*?<\\/script>/gis, '');\ncleanText = cleanText.replace(/<style[^>]*>.*?<\\/style>/gis, '');\n\n// Remove HTML tags\ncleanText = cleanText.replace(/<[^>]+>/g, ' ');\n\n// Decode HTML entities\ncleanText = cleanText\n  .replace(/&nbsp;/g, ' ')\n  .replace(/&amp;/g, '&')\n  .replace(/&lt;/g, '<')\n  .replace(/&gt;/g, '>')\n  .replace(/&quot;/g, '\"')\n  .replace(/&#39;/g, \"'\");\n\n// Remove extra whitespace\ncleanText = cleanText.replace(/\\s+/g, ' ').trim();\n\n// Limit to 3000 characters\ncleanText.substring(0, 3000);\n}}",
              "type": "string"
            },
            {
              "id": "title-assignment",
              "name": "currentTitle",
              "value": "={{ \nconst html = $json.data || '';\nconst titleMatch = html.match(/<title[^>]*>([^<]+)<\\/title>/i);\ntitleMatch ? titleMatch[1].trim() : '';\n}}",
              "type": "string"
            },
            {
              "id": "desc-assignment",
              "name": "currentDescription",
              "value": "={{ \nconst html = $json.data || '';\nconst metaMatch = html.match(/<meta[^>]*name=[\"']description[\"'][^>]*content=[\"']([^\"']*)[\"']/i);\nmetaMatch ? metaMatch[1].trim() : '';\n}}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "extract-content-node",
      "name": "Extract Page Content",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash-exp:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "={{ $credentials.apiKey }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": []
        },
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"Analyze the following web page content and generate SEO-optimized meta title and meta description in ITALIAN language.\\n\\nPage URL: {{ $json.url }}\\nCurrent Title: {{ $json.currentTitle }}\\nCurrent Meta Description: {{ $json.currentDescription }}\\n\\nPage Content:\\n{{ $json.pageContent }}\\n\\nGenerate:\\n1. An optimized meta title in Italian (max 60 characters) that is engaging and includes primary keywords\\n2. An optimized meta description in Italian (max 160 characters) that is compelling and encourages clicks\\n\\nReturn ONLY a valid JSON object with this exact structure (no markdown, no extra text):\\n{\\n  \\\"optimizedTitle\\\": \\\"your optimized title here\\\",\\n  \\\"optimizedDescription\\\": \\\"your optimized description here\\\"\\n}\"\n    }]\n  }]\n}",
        "options": {}
      },
      "id": "gemini-api-node",
      "name": "Generate Meta Tags with Gemini",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300],
      "credentials": {
        "googlePalmApi": {
          "id": "your-gemini-credential-id",
          "name": "Google PaLM API"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "row-pass",
              "name": "rowNumber",
              "value": "={{ $('Extract Page Content').item.json.rowNumber }}",
              "type": "number"
            },
            {
              "id": "title-parsed",
              "name": "optimizedTitle",
              "value": "={{ \nconst response = $json;\nconst text = response.candidates?.[0]?.content?.parts?.[0]?.text || '{}';\nlet parsed;\ntry {\n  // Remove markdown code blocks if present\n  const cleanText = text.replace(/```json\\n?/g, '').replace(/```/g, '').trim();\n  parsed = JSON.parse(cleanText);\n} catch (e) {\n  // Try to extract JSON from text\n  const jsonMatch = text.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    parsed = JSON.parse(jsonMatch[0]);\n  } else {\n    parsed = { optimizedTitle: 'Error parsing response', optimizedDescription: 'Error parsing response' };\n  }\n}\nparsed.optimizedTitle || 'No title generated';\n}}",
              "type": "string"
            },
            {
              "id": "desc-parsed",
              "name": "optimizedDescription",
              "value": "={{ \nconst response = $json;\nconst text = response.candidates?.[0]?.content?.parts?.[0]?.text || '{}';\nlet parsed;\ntry {\n  const cleanText = text.replace(/```json\\n?/g, '').replace(/```/g, '').trim();\n  parsed = JSON.parse(cleanText);\n} catch (e) {\n  const jsonMatch = text.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    parsed = JSON.parse(jsonMatch[0]);\n  } else {\n    parsed = { optimizedTitle: 'Error', optimizedDescription: 'Error' };\n  }\n}\nparsed.optimizedDescription || 'No description generated';\n}}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "parse-response-node",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "={{ $('Read Google Sheets').first().json.spreadsheetId }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "list",
          "cachedResultName": "Sheet1"
        },
        "dataMode": "define",
        "columnToMatchOn": "URL",
        "valueOfColumnToMatchOn": "={{ $('Extract Page Content').item.json.url }}",
        "fieldsUi": {
          "fieldValues": [
            {
              "column": "Meta Title",
              "fieldValue": "={{ $json.optimizedTitle }}"
            },
            {
              "column": "Meta Description",
              "fieldValue": "={{ $json.optimizedDescription }}"
            }
          ]
        },
        "options": {}
      },
      "id": "update-sheets-node",
      "name": "Update Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [1560, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "your-credential-id",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "amount": 2,
        "unit": "seconds"
      },
      "id": "wait-node",
      "name": "Wait to avoid rate limiting",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1780, 300],
      "webhookId": "rate-limit-wait"
    }
  ],
  "pinData": {},
