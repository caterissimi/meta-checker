      "id": "9a6b4d78-2c3e-4f5a-8b1c-234567890bcd",
      "name": "Google Sheets - Read URLs",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [450, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
